{
    "name": "ubixsys/ubixcore-skeleton",
    "description": "Skeleton host project for uBixCore: composer create-project ubixsys/ubixcore-skeleton <name>",
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        { "type": "vcs", "url": "git@gitlab.brainchurts.com:ubixsys/ubixcore.git" }
    ],
    "require": {
        "php": "^8.3",
        "ubixsys/ubixcore": "dev-dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.2",
        "rector/rector": "^2.1",
        "slevomat/coding-standard": "^8.19",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "php/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "review": "@php bin/ubix code:review -n"
    }
}
